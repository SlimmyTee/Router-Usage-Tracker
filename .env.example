# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit real credentials.

# Comma-separated list of router keys. Each key becomes an env-var
# prefix below (upper-cased, non-alphanumerics replaced with _).
# The key is the stable id stored in the database; <KEY>_NAME is the
# display name used in reports and logs, changeable at any time.
ROUTERS=mtn,airtel,mtn2

# --- Huawei OptiXstar HG8145X7-10 (MTN GPON ONT) ---
MTN_NAME=MTN Fibre
MTN_TYPE=huawei-hg8145x7
MTN_URL=http://192.168.100.1
MTN_USERNAME=root
MTN_PASSWORD=

# --- Airtel CPE ("Highwmg" Vue firmware, JSON API) ---
AIRTEL_NAME=Airtel
AIRTEL_TYPE=airtel-httpcgi
AIRTEL_URL=http://192.168.1.1
AIRTEL_USERNAME=admin
AIRTEL_PASSWORD=

# --- ZTE zwrt/OpenWrt CPE (e.g. MC8830 5G) — password-only login ---
MTN2_NAME=MTN Router
MTN2_TYPE=zte-zwrt
MTN2_URL=http://192.168.0.1
MTN2_PASSWORD=
